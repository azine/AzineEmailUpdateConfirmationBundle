{
    "name": "azine/emailupdateconfirmation-bundle",
    "type": "symfony-bundle",
    "description": "Symfony bundle that requires confirmation before applying a user's changed email address.",
    "keywords": [
        "email",
        "confirmation",
        "fosuser",
        "symfony"
    ],
    "homepage": "https://github.com/azine/AzineEmailUpdateConfirmationBundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Azine IT Services AG",
            "email": "github@azine-it.ch"
        }
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/azine/email-bundle"
        }
    ],
    "require": {
        "php": "^8.5",
        "ext-json": "*",
        "ext-openssl": "*",
        "doctrine/orm": "^3.6",
        "friendsofsymfony/user-bundle": "^4.1",
        "symfony/config": "^7.4",
        "symfony/dependency-injection": "^7.4",
        "symfony/event-dispatcher": "^7.4",
        "symfony/event-dispatcher-contracts": "^3.7",
        "symfony/framework-bundle": "^7.4",
        "symfony/http-foundation": "^7.4",
        "symfony/http-kernel": "^7.4",
        "symfony/mailer": "^7.4",
        "symfony/mime": "^7.4",
        "symfony/routing": "^7.4",
        "symfony/security-core": "^7.4",
        "symfony/translation": "^7.4",
        "symfony/twig-bridge": "^7.4",
        "symfony/validator": "^7.4",
        "symfony/yaml": "^7.4",
        "twig/twig": "^3.14"
    },
    "require-dev": {
        "azine/email-bundle": "^5.0.1",
        "doctrine/doctrine-bundle": "^2.15",
        "friendsofphp/php-cs-fixer": "^3.90",
        "phpunit/phpunit": "^12.5",
        "symfony/phpunit-bridge": "^7.4"
    },
    "suggest": {
        "azine/email-bundle": "Use the application's branded Azine Email Bundle templates for confirmation messages."
    },
    "autoload": {
        "psr-4": {
            "Azine\\EmailUpdateConfirmationBundle\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Azine\\EmailUpdateConfirmationBundle\\Tests\\": "Tests/"
        }
    },
    "scripts": {
        "lint": "find . -path './vendor' -prune -o -path './.git' -prune -o -name '*.php' -print0 | xargs -0 -n1 php -l",
        "test": "phpunit -c phpunit.xml.dist"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
