<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/12.5/phpunit.xsd"
         bootstrap="Tests/bootstrap.php"
         cacheDirectory=".phpunit.cache"
         colors="true"
         beStrictAboutOutputDuringTests="true"
         failOnRisky="true"
         failOnWarning="true">
    <testsuites>
        <testsuite name="Azine EmailUpdateConfirmationBundle Test Suite">
            <directory suffix="Test.php">Tests</directory>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <file>AzineEmailUpdateConfirmationBundle.php</file>
            <file>AzineEmailUpdateConfirmationEvents.php</file>
            <directory suffix=".php">Controller</directory>
            <directory suffix=".php">DependencyInjection</directory>
            <directory suffix=".php">Doctrine</directory>
            <directory suffix=".php">EventListener</directory>
            <directory suffix=".php">Mailer</directory>
            <directory suffix=".php">Services</directory>
        </include>
    </source>
</phpunit>
